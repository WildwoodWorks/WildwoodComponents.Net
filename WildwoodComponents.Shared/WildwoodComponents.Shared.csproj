<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 exists so WildwoodComponents.WebForms (.NET Framework 4.8)
         can consume the same models/utilities. The Seeder is net10.0-only. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WildwoodComponents.Shared</RootNamespace>

    <!-- Package Metadata -->
    <PackageId>WildwoodComponents.Shared</PackageId>
    <Version>1.0.0</Version>
    <Authors>Wildwood Development Team</Authors>
    <Company>Wildwood</Company>
    <Product>WildwoodComponents.Shared</Product>
    <Description>Shared DTOs and models used by both WildwoodComponents (Blazor) and WildwoodComponents.Razor (Razor Pages) libraries.</Description>
    <PackageTags>wildwood;shared;models;dto</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Seeder component core: HTTP SDK + hosted runner (framework-neutral, no Blazor).
       Seeder-only, so these are net10.0-only alongside the Seeder itself. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <!-- The Seeder uses records/required/init and IHostedService, none of which exist
       on netstandard2.0; it is a server-startup harness with no WebForms counterpart. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Seeder\**" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Http\WildwoodRetryHandler is shared with WebForms and logs through ILogger. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
