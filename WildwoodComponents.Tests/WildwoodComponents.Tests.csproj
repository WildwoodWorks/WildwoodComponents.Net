<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WildwoodComponents.Shared\WildwoodComponents.Shared.csproj" />
    <ProjectReference Include="..\WildwoodComponents.Blazor\WildwoodComponents.Blazor.csproj" />
    <ProjectReference Include="..\WildwoodComponents.Razor\WildwoodComponents.Razor.csproj" />
    <!-- The Playwright helpers. This is the ONLY project that may reference them: it is what brings
         Microsoft.Playwright into a build at all, and a shipped UI package picking it up is the
         thing WildwoodComponents.Testing exists to prevent. -->
    <ProjectReference Include="..\WildwoodComponents.Testing\WildwoodComponents.Testing.csproj" />
  </ItemGroup>

</Project>