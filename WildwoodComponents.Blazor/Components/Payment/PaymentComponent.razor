@using WildwoodComponents.Blazor.Components.Base
@using WildwoodComponents.Blazor.Models
@using WildwoodComponents.Blazor.Services
@using WildwoodComponents.Blazor.Services.Payment
@using Microsoft.AspNetCore.Components.Forms
@inherits BaseWildwoodComponent

<div class="@GetRootCssClasses() payment-component">
    @if (IsLoading && ShowLoadingStates)
    {
        <div class="payment-loading text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">@(_loadingMessage ?? "Loading payment options...")</p>
        </div>
    }
    else if (_paymentComplete && _paymentResult != null)
    {
        <!-- Payment Success -->
        <div class="payment-success text-center py-4">
            <div class="success-icon mb-3">
                <i class="bi bi-check-circle-fill text-success"></i>
            </div>
            @if (_trialEndsAt.HasValue)
            {
                <h4 class="text-success">Your free trial has started!</h4>
                <p class="mb-0">
                    Your card is saved. You won't be charged until
                    <strong>@_trialEndsAt.Value.ToString("MMM d, yyyy")</strong>, when
                    <strong>@FormatAmount(Amount, Currency)</strong> is due.
                </p>
            }
            else
            {
                <h4 class="text-success">Payment Successful!</h4>
                <p class="transaction-id-display">Transaction ID: <code>@_paymentResult.TransactionId</code></p>
                <p class="mb-0">Amount: <strong>@FormatAmount(Amount, Currency)</strong></p>
            }
            @if (!string.IsNullOrEmpty(_paymentResult.ReceiptUrl))
            {
                <a href="@_paymentResult.ReceiptUrl" target="_blank" class="btn btn-outline-primary mt-3">
                    <i class="bi bi-receipt me-2"></i>View Receipt
                </a>
            }
            @* Continue renders only for a host that asked for it. It used to re-fire
               OnPaymentSuccess, running the host's success handler a second time. *@
            @if (OnContinue.HasDelegate)
            {
                <button class="btn btn-primary mt-3 ms-2" @onclick="HandleSuccessContinue">
                    Continue
                </button>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage) && EnableErrorHandling)
    {
        <!-- Payment Error -->
        <div class="payment-error">
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span class="error-message">@ErrorMessage</span>
                <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
            </div>
            <button class="btn btn-outline-primary" @onclick="RetryPayment">
                <i class="bi bi-arrow-clockwise me-2"></i>Try Again
            </button>
        </div>
    }
    else
    {
        <!-- Payment Form -->
        <div class="payment-form">
            @* Tracking Prevention Warning *@
            @if (_trackingPreventionDetected)
            {
                <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-shield-exclamation me-2"></i>
                    <strong>Browser Privacy Settings Detected</strong>
                    <p class="mb-0 small mt-1">
                        Your browser's tracking prevention may affect payment processing. 
                        If you experience issues, try disabling tracking prevention for this site or using a different browser.
                    </p>
                    <button type="button" class="btn-close" @onclick="() => _trackingPreventionDetected = false" aria-label="Close"></button>
                </div>
            }

            @* The plan advertised a trial the account cannot have: nothing has been charged, and
               the next Pay click confirms the SAME intent rather than starting another one. *@
            @if (_trialUnavailable)
            {
                <div class="alert alert-warning mb-3" role="alert">
                    The free trial isn't available on your account, so @FormatAmount(Amount, Currency) will be charged today. Select Pay to continue.
                </div>
            }

            <!-- Amount Display -->
            @if (ShowAmount)
            {
                <div class="payment-amount-display mb-4 text-center">
                    <span class="amount-value fs-3 fw-bold">@FormatAmount(Amount, Currency)</span>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="text-muted mb-0">@Description</p>
                    }
                </div>
            }

            <!-- Platform Notice -->
            @if (_platformInfo?.RequiresAppStorePayment == true)
            {
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    @if (PlatformService.CurrentPlatform == RuntimePlatform.iOS || 
                         PlatformService.CurrentPlatform == RuntimePlatform.macOS)
                    {
                        <text>Payment will be processed through the App Store.</text>
                    }
                    else if (PlatformService.CurrentPlatform == RuntimePlatform.Android)
                    {
                        <text>Payment will be processed through Google Play.</text>
                    }
                </div>
            }

            <!-- Provider Selection -->
            @* != true, not !(... == true): the latter parses as (!x) == true and hid the picker
               whenever platform info had not loaded. *@
            @if (_availableProviders.Count > 1 && _platformInfo?.RequiresAppStorePayment != true)
            {
                <div class="payment-providers mb-4">
                    <label class="form-label fw-bold">Payment Method</label>
                    <div class="provider-list">
                        @foreach (var provider in _availableProviders)
                        {
                            <div class="provider-option @(_selectedProvider?.Id == provider.Id ? "selected" : "")"
                                 @onclick="() => SelectProvider(provider)">
                                <div class="provider-icon">
                                    <i class="@provider.GetIconClass()"></i>
                                </div>
                                <div class="provider-name">
                                    @provider.GetDisplayLabel()
                                </div>
                                @if (provider.IsDefault)
                                {
                                    <span class="badge bg-primary ms-2">Default</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Provider-Specific Payment Form -->
            @if (_selectedProvider != null)
            {
                <div class="payment-form-content">
                    @switch ((PaymentProviderType)_selectedProvider.ProviderType)
                    {
                        case PaymentProviderType.Stripe:
                            <!-- Stripe Card Element -->
                            <div class="stripe-payment">
                                <div class="mb-3">
                                    <label class="form-label">Card Details</label>
                                    <div id="stripe-card-element" class="stripe-element"></div>
                                    <div id="stripe-card-errors" class="text-danger small mt-1"></div>
                                </div>
                                @if (RequireBillingAddress)
                                {
                                    @RenderBillingAddressForm()
                                }
                            </div>
                            break;

                        case PaymentProviderType.PayPal:
                            <!-- PayPal Button Container -->
                            <div class="paypal-payment">
                                @* PayPal loading indicator - shown outside the button container *@
                                @if (!_paypalButtonsLoaded)
                                {
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading PayPal...</span>
                                        </div>
                                        <p class="text-muted small mt-2 mb-0">Loading PayPal buttons...</p>
                                    </div>
                                }
                                @* PayPal renders its buttons here - don't put conditional content inside *@
                                <div id="paypal-button-container" class="paypal-buttons-container @(_paypalButtonsLoaded ? "" : "d-none")">
                                </div>
                                <p class="text-muted small mt-2 text-center">
                                    <i class="bi bi-shield-check me-1"></i>Secure payment via PayPal
                                </p>
                            </div>
                            break;

                        case PaymentProviderType.ApplePay:
                            <!-- Apple Pay Button -->
                            <div class="apple-pay-payment text-center">
                                <div id="apple-pay-button" class="apple-pay-button apple-pay-button-black"></div>
                                <p class="text-muted small mt-2">Use Face ID or Touch ID to confirm payment.</p>
                            </div>
                            break;

                        case PaymentProviderType.GooglePay:
                            <!-- Google Pay Button -->
                            <div class="google-pay-payment text-center">
                                <div id="google-pay-button"></div>
                                <p class="text-muted small mt-2">Pay securely with Google Pay.</p>
                            </div>
                            break;

                        case PaymentProviderType.AppleAppStore:
                        case PaymentProviderType.GooglePlayStore:
                            <!-- App Store Payment -->
                            <div class="app-store-payment text-center">
                                <button class="btn btn-lg @((PaymentProviderType)_selectedProvider.ProviderType == PaymentProviderType.AppleAppStore ? "btn-dark" : "btn-success")"
                                        @onclick="InitiateAppStorePurchase"
                                        disabled="@_isProcessing">
                                    @if (_isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @if ((PaymentProviderType)_selectedProvider.ProviderType == PaymentProviderType.AppleAppStore)
                                    {
                                        <i class="bi bi-apple me-2"></i>
                                        <text>Purchase with Apple</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-google-play me-2"></i>
                                        <text>Purchase with Google Play</text>
                                    }
                                </button>
                                <p class="text-muted small mt-3">
                                    @if ((PaymentProviderType)_selectedProvider.ProviderType == PaymentProviderType.AppleAppStore)
                                    {
                                        <text>Your payment will be charged to your Apple ID account.</text>
                                    }
                                    else
                                    {
                                        <text>Your payment will be charged to your Google Play account.</text>
                                    }
                                </p>
                            </div>
                            break;

                        case PaymentProviderType.Klarna:
                        case PaymentProviderType.Affirm:
                        case PaymentProviderType.Afterpay:
                            <!-- BNPL Payment -->
                            <div class="bnpl-payment text-center">
                                <div class="alert alert-warning">
                                    <i class="bi bi-clock me-2"></i>
                                    <strong>Pay in installments</strong>
                                    <p class="mb-0 mt-1 small">Split your payment into easy installments with @_selectedProvider.GetDisplayLabel().</p>
                                </div>
                                <button class="btn btn-warning btn-lg" @onclick="InitiateBnplPayment" disabled="@_isProcessing">
                                    @if (_isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Continue with @_selectedProvider.GetDisplayLabel()
                                </button>
                            </div>
                            break;

                        default:
                            <!-- Generic Card Form -->
                            <div class="generic-payment">
                                <div class="mb-3">
                                    <label class="form-label">Card Number</label>
                                    <input type="text" class="form-control" @bind="_cardNumber" 
                                           placeholder="1234 5678 9012 3456" maxlength="19" />
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">Expiry</label>
                                            <input type="text" class="form-control" @bind="_cardExpiry" 
                                                   placeholder="MM/YY" maxlength="5" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label class="form-label">CVV</label>
                                            <input type="text" class="form-control" @bind="_cardCvv" 
                                                   placeholder="123" maxlength="4" />
                                        </div>
                                    </div>
                                </div>
                                @if (RequireBillingAddress)
                                {
                                    @RenderBillingAddressForm()
                                }
                            </div>
                            break;
                    }
                </div>

                <!-- Submit Button (for non-redirect flows) -->
                @if (!IsRedirectProvider(_selectedProvider.ProviderType))
                {
                    <div class="payment-submit mt-4">
                        @if (!string.IsNullOrEmpty(_formError))
                        {
                            <div class="alert alert-danger" role="alert">@_formError</div>
                        }
                        <button class="btn btn-primary btn-lg w-100"
                                @onclick="ProcessPayment"
                                disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <text>Processing...</text>
                            }
                            else if (HasTrial)
                            {
                                <i class="bi bi-lock-fill me-2"></i>
                                <text>Start @TrialDays-day free trial</text>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill me-2"></i>
                                <text>Pay @FormatAmount(Amount, Currency)</text>
                            }
                        </button>
                        @if (HasTrial)
                        {
                            <p class="ww-order-summary-trial text-muted small mt-2 mb-0">
                                You won't be charged today. @FormatAmount(Amount, Currency) is due when the trial ends unless you cancel before then.
                            </p>
                        }
                    </div>
                }

                <!-- Security Notice -->
                <div class="payment-security text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-shield-lock me-1"></i>
                        Secured by @_selectedProvider.GetDisplayLabel()
                    </small>
                </div>
            }
            else if (_availableProviders.Count == 0)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>No payment methods available</strong>
                    <p class="small mb-0 mt-2">
                        @if (!string.IsNullOrEmpty(_noProvidersReason))
                        {
                            @_noProvidersReason
                        }
                        else
                        {
                            <text>No payment methods are available for this app on your current platform.</text>
                        }
                    </p>
                    <details class="mt-2">
                        <summary class="small text-muted" style="cursor: pointer;">
                            <i class="bi bi-bug me-1"></i>Technical details (click to expand)
                        </summary>
                        <div class="mt-2 p-2 bg-light rounded" style="font-family: monospace; font-size: 0.75rem;">
                            <div><strong>AppId:</strong> @AppId</div>
                            <div><strong>Platform:</strong> @(_platformInfo?.Platform ?? PlatformService.CurrentPlatform.ToString())</div>
                            <div><strong>Platform Flags:</strong> @_platformFlags (0x@(_platformFlags.ToString("X")))</div>
                            <div><strong>RequiresAppStore:</strong> @(_platformInfo?.RequiresAppStorePayment ?? PlatformService.RequiresAppStorePayment)</div>
                            <div><strong>API Response:</strong> @(_apiResponseStatus ?? "Unknown")</div>
                            <div><strong>Providers from API:</strong> @_providersFromApi</div>
                            <div><strong>Providers after filtering:</strong> @_availableProviders.Count</div>
                            @if (_filteringDetails.Count > 0)
                            {
                                <div class="mt-2">
                                    <strong>Provider filtering log:</strong>
                                    <ul class="mb-0 ps-3">
                                        @foreach (var detail in _filteringDetails)
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_debugInfo))
                            {
                                <div class="mt-2">
                                    <strong>Additional info:</strong>
                                    <pre class="mb-0 mt-1" style="white-space: pre-wrap; word-break: break-all;">@_debugInfo</pre>
                                </div>
                            }
                        </div>
                        <div class="mt-2 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Check browser console (F12) for detailed API logs. Look for "[PaymentProviderService]" or "[PaymentComponent]" entries.
                        </div>
                    </details>
                </div>
            }

            <!-- Cancel Button -->
            @if (OnCancel.HasDelegate)
            {
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-link" @onclick="HandleCancel">
                        Cancel
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    // Markup-bearing render fragment: Razor template syntax cannot live in a plain .cs file
    // without being rewritten into RenderTreeBuilder calls, so it stays with the markup.
    // All other C# lives in PaymentComponent.razor.cs / PaymentComponent.Stripe.cs.
    private RenderFragment RenderBillingAddressForm() => __builder =>
    {
        <div class="billing-address mt-4">
            <h6>Billing Address</h6>
            <div class="row">
                <div class="col-6">
                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" class="form-control" @bind="_billingFirstName" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" class="form-control" @bind="_billingLastName" />
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input type="text" class="form-control" @bind="_billingAddress" />
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="mb-3">
                        <label class="form-label">City</label>
                        <input type="text" class="form-control" @bind="_billingCity" />
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-3">
                        <label class="form-label">State</label>
                        <input type="text" class="form-control" @bind="_billingState" />
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-3">
                        <label class="form-label">ZIP</label>
                        <input type="text" class="form-control" @bind="_billingZip" />
                    </div>
                </div>
            </div>
        </div>
    };
}
<style>
.payment-component {
    max-width: 500px;
    margin: 0 auto;
}

.payment-amount-display {
    background: var(--ww-bg-tertiary, #f8f9fa);
    padding: 1.5rem;
    border-radius: var(--ww-border-radius, 0.5rem);
}

.provider-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.provider-option {
    display: flex;
    align-items: center;
    padding: 1rem;
    border: 2px solid var(--ww-border-color, #dee2e6);
    border-radius: var(--ww-border-radius-sm, 0.375rem);
    cursor: pointer;
    transition: all 0.2s;
}

.provider-option:hover {
    border-color: var(--ww-primary, #0d6efd);
    background: var(--ww-bg-secondary, #f8f9fa);
}

.provider-option.selected {
    border-color: var(--ww-primary, #0d6efd);
    background: var(--ww-primary-bg, rgba(13, 110, 253, 0.1));
}

.provider-icon {
    font-size: 1.5rem;
    width: 40px;
    text-align: center;
    color: var(--ww-text-secondary, #6c757d);
}

.provider-option.selected .provider-icon {
    color: var(--ww-primary, #0d6efd);
}

.provider-name {
    flex: 1;
    font-weight: 500;
}

.stripe-element {
    padding: 12px;
    border: 1px solid var(--ww-border-color, #ced4da);
    border-radius: var(--ww-border-radius-sm, 0.375rem);
    background: var(--ww-input-bg, #ffffff);
    min-height: 44px;
}

.stripe-element.StripeElement--focus {
    border-color: var(--ww-primary, #0d6efd);
    box-shadow: 0 0 0 0.25rem var(--ww-focus-ring, rgba(13, 110, 253, 0.25));
}

.apple-pay-button {
    width: 100%;
    height: 48px;
    border-radius: 4px;
    cursor: pointer;
}

.payment-security {
    color: var(--ww-text-muted, #6c757d);
}

.payment-success {
    background: var(--ww-success-bg, rgba(25, 135, 84, 0.1));
    padding: 2rem;
    border-radius: var(--ww-border-radius, 0.5rem);
}

.payment-loading {
    padding: 3rem;
}

.paypal-buttons-container {
    min-height: 150px;
}

.transaction-id-display {
    font-size: 1.1rem;
    font-weight: 500;
    color: #333;
    margin-top: 0.5rem;
}
</style>
