<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet merges this into the consuming site's web.config on install and removes the same
  entries on uninstall. BaseUrl points at the public WildwoodAPI; fill in the ApiKey and
  AppId for your Wildwood app, which are left blank on purpose.
-->
<configuration>
  <appSettings>
    <add key="WildwoodAPI:BaseUrl" value="https://api.wildwoodworks.io/api" />
    <add key="WildwoodAPI:ApiKey" value="" />
    <add key="WildwoodAPI:AppId" value="" />
  </appSettings>
  <system.webServer>
    <!--
      Integrated pipeline, the default for IIS 7 and later.

      The classic-pipeline equivalent is deliberately NOT registered here. Declaring
      <system.web><httpModules> in a site running on an Integrated-mode application pool
      makes ASP.NET refuse to start it at all — every request returns HTTP 500.22 — so
      adding it on install would take down the majority of sites, which run Integrated.
      If your application pool is in Classic mode, add this by hand instead:

        <system.web>
          <httpModules>
            <add name="WildwoodTokenExpiration"
                 type="WildwoodComponents.WebForms.Modules.WildwoodTokenExpirationModule, WildwoodComponents.WebForms" />
          </httpModules>
        </system.web>
    -->
    <modules>
      <add name="WildwoodTokenExpiration"
           type="WildwoodComponents.WebForms.Modules.WildwoodTokenExpirationModule, WildwoodComponents.WebForms" />
    </modules>
  </system.webServer>
</configuration>
